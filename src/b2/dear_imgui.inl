#define ENAME ImGuiTextureFilter
EBEGIN_DERIVED(uint64_t)
EMETA_SIZE_BITS(2)
EPN(Default)
EPN(Point)
EPN(Linear)
EEND()
#undef ENAME

//////////////////////////////////////////////////////////////////////////
//////////////////////////////////////////////////////////////////////////

#define ENAME ImTextureIDBits
EBEGIN_DERIVED(uint64_t)
// set if index into ImGuiStuff textures table; reset if the whole value is
// actually a SDL_Texture *
EPN_BIT_FLAG(IsImGuiTexture, 0)

// index into the SDL_Texture table.
EPN_BIT_FIELD(Index, 1, 8)

// some bits that change each time a given table entry is reused, so stale
// references can be handled correctly.
EPN_BIT_FIELD(Unique, 9, 32)

// texture filter option
EPN_BIT_FIELD_ENUM(Filter, 41, 2, ImGuiTextureFilter)
EEND()
#undef ENAME

